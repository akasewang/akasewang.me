# Database Configuration (Neon Serverless Postgres)
NEON_DATABASE_URL=postgres://user:password@host.neon.tech/dbname?sslmode=require

# Rate Limiting & Security
# Random server secret used to pseudonymize IP-based public-action cooldown keys.
RATE_LIMIT_SECRET=replace_with_a_random_32_byte_hex_value

# Email Delivery & Authentication (Resend)
# API key from your Resend dashboard for transactional emails and broadcasts.
RESEND_API_KEY=your_resend_api_key

# Destination inbox where admin OTP verification codes and weekly subscriber summaries
# are delivered. Also the email address required to request admin access.
RESEND_ADMIN_EMAIL=admin@example.com

# Verified sender email address used to send admin OTP verification codes (e.g., otp@yourdomain.com).
RESEND_OTP_EMAIL=otp@yourdomain.com

# Verified sender email address used for newsletter broadcasts and subscriber welcome emails (e.g., newsletter@yourdomain.com).
RESEND_NEWSLETTER_EMAIL=newsletter@yourdomain.com

# Scheduled Jobs & Webhooks
# Bearer secret protecting the weekly subscriber summary cron endpoint (/api/cron/weekly-summary).
CRON_SECRET=your_cron_secret

# GitHub API (optional)
# Fine-grained personal access token with read-only access to the site repository.
# Raises the API rate limit for the changelog and star count; both fall back to
# anonymous requests if this is unset, expired or mis-scoped.
GITHUB_TOKEN=your_github_token
