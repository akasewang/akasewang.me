# Database Configuration (Neon Serverless Postgres)
NEON_DATABASE_URL=postgres://user:password@host.neon.tech/dbname?sslmode=require

# Random server secret used to pseudonymize IP-based public-action cooldown keys.
RATE_LIMIT_SECRET=replace_with_a_random_32_byte_hex_value

# Admin Authentication
# Admin access is an eight-character code, mailed to OTP_EMAIL on request and good for ten minutes.
# The broadcast page asks for OTP_EMAIL and the code. On the message board, entering OTP_EMAIL
# requests a code; the next eight-character code entered signs in. Neither is posted to the board.
OTP_EMAIL=admin@example.com

# Where the weekly subscriber summary is reported to. May be the same address as OTP_EMAIL.
ADMIN_EMAIL=admin@example.com

# Email & Newsletter Delivery (Resend)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL="newsletter@yourdomain.com"

# Scheduled Jobs & Webhooks
CRON_SECRET=your_cron_secret

# GitHub API (optional)
# Fine grained personal access token with read only access to the site repository.
# Raises the API rate limit for the changelog and star count, both fall back to
# anonymous requests if this is unset, expired or mis-scoped.
GITHUB_TOKEN=your_github_token
